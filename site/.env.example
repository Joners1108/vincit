# Copia para site/.env (só este ficheiro é carregado por esta instalação).
# Guia completo (arranque, BD, emails, passwords): ver README.md na raiz do projeto vincit/.
#
# Copia para .env e ajusta (Laragon típico)
# Site — deixa SITE_URL vazio para auto-detectar (recomendado). Só define se precisares (ex.: CDN).
SITE_NAME=Vincit
SITE_URL=
SITE_EMAIL=info@vincit.pt
SITE_PHONE=+351 123 456 789
SITE_ADDRESS=Lisboa, Portugal

# Base de dados (Laragon MySQL)
DB_HOST=localhost
DB_NAME=vincit_db
DB_USER=root
DB_PASS=

# Modo desenvolvimento (true/false)
APP_DEBUG=true

# Stripe — apenas aqui (não há edição no Admin → Configurações)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Só para desenvolvimento: permite finalizar encomenda SEM redirecionar ao Stripe (pagamento “simulado”).
# Em produção mantém false ou apaga a linha.
ALLOW_SIMULATED_CHECKOUT=false

# Envio
SHIPPING_COST=5.00
FREE_SHIPPING_THRESHOLD=50.00

# Moradas no checkout (OpenStreetMap Nominatim — gratuito, sem Google)
# Política OSM: identifica a app com email de contacto válido
ADDRESS_AUTOCOMPLETE_ENABLED=true
NOMINATIM_USER_AGENT=VincitStore/1.0 (contacto: o-teu-email@exemplo.com)

# ---------------------------------------------------------------------------
# Email — escolhe UM dos modos (por ordem no código: Resend > SMTP > mail())
# ---------------------------------------------------------------------------
#
# A) Resend (recomendado se não quiseres conta SMTP nova): só API key, HTTP.
#    Conta em https://resend.com — em testes podes usar remetente onboarding@resend.dev
#    e enviar só para o teu email. Com domínio próprio, verifica o domínio no painel Resend.
#RESEND_API_KEY=re_xxxxxxxx
# Opcional: força o remetente (tem de ser permitido no painel Resend)
#RESEND_FROM=Vincit <onboarding@resend.dev>
#
# B) SMTP + PHPMailer (Gmail/Outlook/etc. — podes usar conta que JÁ tens + palavra-passe de app)
#
# Outlook.com / Hotmail (conta pessoal Microsoft):
#MAIL_HOST=smtp-mail.outlook.com
#MAIL_PORT=587
#MAIL_ENCRYPTION=tls
#MAIL_USER=o-teu@outlook.com
#MAIL_PASS=a-tua-palavra-passe
#MAIL_FROM=o-teu@outlook.com
#MAIL_FROM_NAME=Vincit
# (Com verificação em dois passos ativa, cria "palavra-passe de aplicação" em account.microsoft.com)
#
# Microsoft 365 / email empresarial @empresa.pt:
#MAIL_HOST=smtp.office365.com
#MAIL_PORT=587
#MAIL_ENCRYPTION=tls
#MAIL_USER=nome@empresa.pt
#MAIL_PASS=...
#MAIL_FROM=nome@empresa.pt
#MAIL_FROM_NAME=Vincit
#
# Gmail:
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_ENCRYPTION=tls
#MAIL_USER=o-teu@gmail.com
#MAIL_PASS=palavra-passe-de-app
#MAIL_FROM=o-teu@gmail.com
#MAIL_FROM_NAME=Vincit
#
# C) Nada disto: usa mail() do PHP (no Windows/Laragon muitas vezes não entrega; em alguns hosts funciona)
#ADMIN_NOTIFY_EMAIL=para-onde-chegam-alertas-de-encomenda@exemplo.com
