# Coloca aqui o teu .env (raiz do projeto, ao lado da pasta site/)
# O PHP carrega primeiro este ficheiro, depois site/.env (só preenche variáveis em falta).
#
# URL: se o site abre em http://localhost/vincit/site/ usa exactamente isso (com /site).

SITE_NAME=Vincit
SITE_URL=http://localhost/vincit/site
SITE_EMAIL=info@vincit.pt
SITE_PHONE=+351 123 456 789
SITE_ADDRESS=Lisboa, Portugal

DB_HOST=localhost
DB_NAME=vincit_db
DB_USER=root
DB_PASS=

# APP_DEBUG ou DEBUG (ambos funcionam)
DEBUG=true

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SHIPPING_COST=5.00
FREE_SHIPPING_THRESHOLD=50.00

ADDRESS_AUTOCOMPLETE_ENABLED=true
NOMINATIM_USER_AGENT=VincitStore/1.0 (contacto: info@vincit.pt)
